# ArcGov Environment Variables — Template
# Copy this file to .env.local and fill in your actual values.
# DO NOT commit your actual .env.local file to version control.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Smart Contract Addresses
NEXT_PUBLIC_CONTRACT_ADDRESS=0x6cFe85E12ED12C619f1bd0240b91ce6f4B2a7d99
NEXT_PUBLIC_TARC_ADDRESS=0x0000000000000000000000000000000000000000 # Optional
NEXT_PUBLIC_STAKING_ADDRESS=0x0000000000000000000000000000000000000000 # Optional

# AI Integration
GEMINI_API_KEY=your-gemini-api-key

# Email Notifications (Resend)
# Get a key at https://resend.com/api-keys — never commit a real key.
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL=noreply@arcgov.vercel.app

# Development / Deployment
DEPLOYER_PRIVATE_KEY=your-deployer-private-key
