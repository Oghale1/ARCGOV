# ArcGov Environment Variables — Template
# Copy this file to .env.local and fill in your actual values.
# DO NOT commit your actual .env.local file to version control.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# REQUIRED for form submissions. Forms write through the server-side /api/submit
# route using this service-role key (bypasses RLS, never exposed to the browser).
# Supabase → Project Settings → API → "service_role" secret. Set it in Vercel too.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Smart Contract Addresses
NEXT_PUBLIC_CONTRACT_ADDRESS=0x6cFe85E12ED12C619f1bd0240b91ce6f4B2a7d99
NEXT_PUBLIC_TARC_ADDRESS=0x0000000000000000000000000000000000000000 # Optional
NEXT_PUBLIC_STAKING_ADDRESS=0x0000000000000000000000000000000000000000 # Optional

# AI Integration (Groq — free tier, https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key

# Email Notifications (Gmail + Nodemailer — free, no custom domain)
# GMAIL_USER is the full Gmail address. GMAIL_APP_PASSWORD is a 16-char
# Google "App Password" (Google Account → Security → App passwords), NOT your
# normal password. 2-Step Verification must be enabled to generate one.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Development / Deployment
DEPLOYER_PRIVATE_KEY=your-deployer-private-key
